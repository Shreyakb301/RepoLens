# FastAPI serves the built SPA, so the frontend calls same-origin `/api/*`
# paths and needs no API URL. In development `npm run dev` proxies `/api` to
# the address below; override it only if the API runs somewhere else.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Points the SPA at an absolute API origin instead of same-origin `/api/*`.
# Leave unset for the single-service deployment.
# VITE_API_URL=

# Comma-separated origins allowed to call the API cross-origin. Not needed for
# the single-service deployment; set it only if another site calls the API.
# REPOLENS_ALLOWED_ORIGINS=https://repolens.example.com

# Optional. Public GitHub activity works without a token. Add a read-only token
# to inspect issues and pull requests for private repositories or avoid low
# anonymous API rate limits. The token is never returned to the frontend.
GITHUB_TOKEN=

# Optional local generation. RepoLens uses an extractive grounded fallback when
# Ollama is unavailable.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:7b

# Enable learned embeddings + FAISS + cross-encoder reranking after installing
# backend/requirements-ml.txt. Disabled by default for instant offline startup.
REPOLENS_ML_ENABLED=0
REPOLENS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
REPOLENS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional metadata/trace location
REPOLENS_DB=backend/data/repolens.db

# Colon-separated directories that the local-folder analyzer may read.
REPOLENS_LOCAL_ROOTS=/Users/you/projects
