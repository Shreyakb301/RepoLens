!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.venv/
/backend/data/
/data/
.pytest_cache/
__pycache__/
*.py[cod]

# build output
/.next/
/.vinext/
/out/
/backend/static/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
